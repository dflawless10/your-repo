{
  "expo": {
    "name": "BidGoat",
    "slug": "BidGoatMobile",
    "version": "5.5.5",
    "icon": "./assets/images/icon.png",
    "scheme": "bidgoat",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "owner": "dflawless",
    "extra": {
      "API_URL": "http://74.208.72.226:5000",
      "EXPO_DEV_SERVER": "http://10.0.0.171:8081",
      "router": {},
      "eas": {
        "projectId": "7dd6cddd-4332-43aa-a42b-d3ed26434f39"
      }
    },
    "ios": {
      "icon": "./assets/images/icon.png",
      "supportsTablet": true,
      "runtimeVersion": {
        "policy": "appVersion"
      },
      "bundleIdentifier": "com.dflawless.BidGoatMobile"
    },
    "android": {
      "icon": "./assets/images/icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "package": "com.dflawless.BidGoatMobile",
      "versionCode": 43,
      "runtimeVersion": "5.5.5",
      "googleServicesFile": "./google-services.json",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "bidgoat"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon-96x96.png",
      "splash": {
        "image": "./assets/images/apple-touch-icon.png",
        "resizeMode": "contain",
        "backgroundColor": "#ffffff"
      }
    },
    "plugins": [
      "./plugins/withFirebaseInit.js",
      "./plugins/withStripeVersion.js",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-font",
      "expo-audio",
      "expo-secure-store",
      "expo-video",
      "expo-web-browser",
      "expo-asset",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#ffffff",
          "sounds": [],
          "androidCollapsedTitle": "#{unread_notifications} new notifications"
        }
      ],
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.dflawless.BidGoatMobile",
          "enableGooglePay": false
        }
      ],
      "expo-build-properties"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "updates": {
      "url": "https://u.expo.dev/7dd6cddd-4332-43aa-a42b-d3ed26434f39"
    }
  }
}
