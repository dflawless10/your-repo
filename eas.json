{
  "cli": {
    "version": ">= 16.26.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "node": "22.12.0",
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "node": "22.12.0",
      "channel": "preview",
      "android": {
        "buildType": "app-bundle",
        "gradleCommand": ":app:bundleRelease"
      }
    },
    "production": {
      "node": "22.12.0",
      "channel": "production",
      "cache": {
        "disabled": false
      },
      "android": {
        "buildType": "app-bundle",
        "gradleCommand": ":app:bundleRelease"
      },
      "env": {
        "ORG_GRADLE_PROJECT_react.includeJitpackRepository": "false"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
